# Valores padrão das variáveis de ambiente (desenvolvimento local com Docker Compose).
#
# Ordem de carregamento: .env < .env.local < .env.$APP_ENV < .env.$APP_ENV.local.
# Variáveis reais do ambiente sempre têm prioridade sobre estes arquivos.
#
# NUNCA coloque segredos de produção aqui nem em outro arquivo versionado.
# Em produção, defina tudo como variável de ambiente real (ou use `bin/console secrets:set`).
# Lista completa e explicada em docs/configuracao.md.

###> symfony/framework-bundle ###
APP_ENV=dev
# Obrigatório em produção: valor aleatório longo (ex.: `openssl rand -hex 32`).
# Também é a chave do HMAC dos códigos de verificação/recuperação.
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8080
###< symfony/routing ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> symfony/mailer ###
MAILER_DSN=null://null
MAILER_FROM=no-reply@mail.popularia.com.br
# Em staging/production: brevo+api://API_KEY@default
BREVO_API_KEY=
# Token secreto para validar POST do webhook Brevo (gerar com: openssl rand -hex 32)
BREVO_WEBHOOK_SECRET=
# Allowlist de destinatários em staging (separados por vírgula). Vazio = sem restrição.
# Exemplo: tester@exemplo.com,dev@exemplo.com
MAILER_STAGING_ALLOWLIST=
###< symfony/mailer ###

###> doctrine/doctrine-bundle ###
# O compose.yaml já define DATABASE_URL para o contêiner; este valor serve para rodar fora dele.
DATABASE_URL="postgresql://popularia:popularia_dev@127.0.0.1:55432/popularia?serverVersion=18&charset=utf8"
###< doctrine/doctrine-bundle ###

###> popularia ###
# Proxies confiáveis, separados por vírgula (IPs ou CIDR). Só deles aceitamos X-Forwarded-For.
# Vazio: o IP registrado é o da conexão. Nunca use 0.0.0.0/0.
TRUSTED_PROXIES=
# Duração do access token e do refresh token, em segundos.
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
# Retenção dos registros de segurança (com IP), em dias. VALOR PROVISÓRIO: precisa de validação
# jurídica antes do lançamento (veja docs/seguranca.md, "Retenção").
SECURITY_EVENT_RETENTION_DAYS=180
###< popularia ###

# Social login: Google e Apple.
# Google: OAuth 2.0 Web Client ID (não o Android nem iOS client).
# Apple: Bundle identifier do app iOS (ex: app.popularia.ios).
# Valores reais somente no Railway. Vazio aqui = social login desabilitado localmente.
GOOGLE_CLIENT_ID=
APPLE_BUNDLE_ID=

# Sentry: error tracking. Vazio = desabilitado (dev local e testes).
# Em staging/production, definir no Railway. Ver docs/observability.md.
SENTRY_DSN=
# "staging" ou "production". Obrigatório no Railway para distinguir os ambientes.
SENTRY_ENVIRONMENT=
# SHA do commit ou ID de release. No Railway, usar $RAILWAY_GIT_COMMIT_SHA.
SENTRY_RELEASE=

# Bucket privado S3-compatible (Railway). Credenciais reais somente no ambiente.
LIBRARY_S3_ENDPOINT=
LIBRARY_S3_BUCKET=
LIBRARY_S3_REGION=auto
LIBRARY_S3_ACCESS_KEY=
LIBRARY_S3_SECRET_KEY=
LIBRARY_S3_PATH_STYLE=0
# "staging" ou "production". Proteção contra usar bucket errado no ambiente errado.
# Vazio = sem verificação (desenvolvimento local). Obrigatório definir no Railway.
LIBRARY_S3_ENVIRONMENT=
