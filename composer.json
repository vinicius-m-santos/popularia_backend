{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "api-platform/doctrine-orm": "^4.4",
        "api-platform/symfony": "^4.4",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.7",
        "lcobucci/jwt": "^5.5",
        "nelmio/cors-bundle": "^2.6",
        "phpdocumentor/reflection-docblock": "^6.0",
        "phpstan/phpdoc-parser": "^2.3",
        "sentry/sentry-symfony": "^5.14",
        "symfony/asset": "7.4.*",
        "symfony/brevo-mailer": "7.4.*",
        "symfony/clock": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/expression-language": "7.4.*",
        "symfony/flex": "^2.12",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-client": "^7.4.23",
        "symfony/intl": "7.4.*",
        "symfony/mailer": "7.4.*",
        "symfony/monolog-bundle": "^4.1",
        "symfony/property-access": "7.4.*",
        "symfony/property-info": "7.4.*",
        "symfony/rate-limiter": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/serializer": "7.4.*",
        "symfony/string": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/uid": "7.4.*",
        "symfony/validator": "7.4.*",
        "symfony/yaml": "7.4.*"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "phpstan/extension-installer": true
        },
        "bump-after-update": true,
        "sort-packages": true,
        "platform": {
            "php": "8.4.27"
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "test": "bin/phpunit",
        "stan": "php -d memory_limit=1G vendor/bin/phpstan analyse --no-progress",
        "psalm": "php -d memory_limit=1G vendor/bin/psalm --no-progress --no-diff --show-info=false",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "check": [
            "@cs",
            "@stan",
            "@psalm",
            "@test",
            "@composer audit"
        ],
        "openapi": "bin/console api:openapi:export --output=docs/openapi.json",
        "test:coverage": "bin/phpunit --coverage-text --coverage-clover=var/coverage/clover.xml"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*",
            "docker": false
        }
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.7",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-symfony": "^2.1",
        "phpunit/phpunit": "^13.4.6",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*",
        "vimeo/psalm": "^7.0.2"
    },
    "scripts-descriptions": {
        "test": "Testes automatizados (recria o banco de testes a partir das migrations).",
        "stan": "An\u00e1lise est\u00e1tica com PHPStan.",
        "psalm": "An\u00e1lise est\u00e1tica com Psalm (baseline em psalm-baseline.xml).",
        "cs": "Confere o estilo de c\u00f3digo sem alterar arquivos.",
        "cs-fix": "Corrige o estilo de c\u00f3digo.",
        "check": "Estilo, an\u00e1lise est\u00e1tica, testes e auditoria de depend\u00eancias.",
        "openapi": "Exporta a especifica\u00e7\u00e3o OpenAPI para docs/openapi.json."
    }
}
