{
	# Sem painel de administração do Caddy e sem HTTPS automático: em produção o TLS
	# termina no proxy/balanceador à frente deste contêiner (veja docs/seguranca.md).
	admin off
	auto_https off
	frankenphp
}

{$SERVER_NAME::80} {
	root * /app/public
	encode zstd gzip

	# Somente o envio de PDF aceita o envelope maior; JSON mantém o limite anterior.
	@library_upload {
		path /api/v1/library/documents
		method POST
	}
	@other_requests {
		not {
			path /api/v1/library/documents
			method POST
		}
	}
	request_body @library_upload {
		max_size 27MB
	}
	request_body @other_requests {
		max_size 1MB
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
	}

	php_server
}
