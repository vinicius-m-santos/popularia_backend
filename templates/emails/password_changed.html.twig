{% extends 'emails/brand_base.html.twig' %}

{% block subject %}Sua senha da Popularia foi alterada{% endblock %}
{% block preheader %}A senha da sua conta mudou e as outras sessões foram encerradas.{% endblock %}
{% block header_label %}SEGURANÇA DA CONTA{% endblock %}
{% block footer_reason %}Você recebeu este e&#8209;mail porque a senha desta conta foi alterada.{% endblock %}

{% block body %}
<p style="margin:0 0 10px;font-family:'IBM Plex Mono','SFMono-Regular',Menlo,Consolas,'Courier New',monospace;font-size:12px;line-height:16px;font-weight:600;letter-spacing:1.2px;text-transform:uppercase;color:#A3261C;"><span style="color:#BF3326;">&#9632;</span>&nbsp;AVISO DE SEGURANÇA</p>
<h1 class="h1" style="margin:0 0 18px;font-family:Anton,Impact,'Arial Narrow Bold','Helvetica Neue',Arial,sans-serif;font-size:34px;line-height:36px;font-weight:400;text-transform:uppercase;color:#15120F;mso-line-height-rule:exactly;">SUA SENHA FOI ALTERADA.</h1>
<p style="margin:0 0 16px;font-family:Archivo,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:16px;line-height:24px;color:#15120F;">Oi, {{ nome }}!</p>
<p style="margin:0 0 20px;font-family:Archivo,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:16px;line-height:24px;color:#15120F;">A senha da sua conta na Popularia acabou de ser alterada. Por segurança, encerramos todas as outras sessões abertas.</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;margin:4px 0 22px;border-collapse:separate;border-spacing:0;">
  <tr>
    <td style="padding:16px 18px;background-color:#FBF7EF;border:2px solid #BF3326;border-left-width:8px;border-radius:6px;">
      <p style="margin:0 0 6px;font-family:Archivo,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:16px;line-height:22px;font-weight:800;color:#A3261C;">Não foi você?</p>
      <p style="margin:0;font-family:Archivo,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;line-height:23px;color:#15120F;">Abra o app agora e use <strong style="font-weight:800;">&ldquo;Esqueci minha senha&rdquo;</strong> pra recuperar o acesso. Se não conseguir entrar, escreva pra <a href="mailto:suporte@popularia.com.br" style="color:#15120F;font-weight:700;text-decoration:underline;">suporte@popularia.com.br</a>.</p>
    </td>
  </tr>
</table>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;">
  <tr>
    <td style="height:20px;border-top:2px dashed #15120F;font-size:0;line-height:0;">&nbsp;</td>
  </tr>
</table>
<p style="margin:0 0 16px;font-family:Archivo,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;line-height:21px;color:#5E554A;">Foi você? Então tá tudo certo, não precisa fazer nada.</p>
{% endblock %}
