{% extends 'emails/base.html.twig' %}
{% set subject = 'Sua senha da Popularia foi alterada' %}

{% block body %}
<p style="margin:0 0 16px;font-size:16px;color:#1A1A1A;line-height:1.5">Olá, {{ name }}!</p>
<p style="margin:0 0 24px;font-size:15px;color:#444444;line-height:1.6">
  A senha da sua conta Popularia foi alterada com sucesso e todas as outras sessões abertas foram encerradas.
</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0">
  <tr>
    <td style="background-color:#FFF3F4;border-left:4px solid #C8192E;border-radius:0 4px 4px 0;padding:16px 20px;margin-bottom:24px">
      <p style="margin:0;font-size:14px;color:#C8192E;font-weight:700">Não foi você?</p>
      <p style="margin:6px 0 0;font-size:14px;color:#444444;line-height:1.5">
        Use &ldquo;Esqueci minha senha&rdquo; no aplicativo agora mesmo para recuperar o acesso.
      </p>
    </td>
  </tr>
</table>
<hr style="border:none;border-top:1px solid #EEEEEE;margin:24px 0">
<p style="margin:0;font-size:13px;color:#888888;line-height:1.5">
  Se foi você quem alterou a senha, não é necessária nenhuma ação adicional.
</p>
{% endblock %}
