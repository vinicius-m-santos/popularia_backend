{% extends 'emails/base.html.twig' %}
{% set subject = 'Código para redefinir sua senha da Popularia' %}

{% block body %}
<p style="margin:0 0 16px;font-size:16px;color:#1A1A1A;line-height:1.5">Olá, {{ name }}!</p>
<p style="margin:0 0 24px;font-size:15px;color:#444444;line-height:1.6">
  Recebemos um pedido para criar uma nova senha na sua conta Popularia.<br>
  Use o código abaixo no aplicativo:
</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0">
  <tr>
    <td align="center" style="padding:8px 0 24px">
      <div style="display:inline-block;background-color:#C8192E;border-radius:6px;padding:16px 32px">
        <span style="font-size:32px;font-weight:700;color:#FFFFFF;letter-spacing:8px;font-family:'Courier New',Courier,monospace">{{ code }}</span>
      </div>
    </td>
  </tr>
</table>
<p style="margin:0 0 8px;font-size:13px;color:#888888;text-align:center">
  Código válido por <strong>30 minutos</strong> &middot; uso único
</p>
<hr style="border:none;border-top:1px solid #EEEEEE;margin:24px 0">
<p style="margin:0;font-size:13px;color:#888888;line-height:1.5">
  Se você não solicitou a recuperação de senha, sua conta está segura &mdash; ignore este e-mail.<br>
  Nunca compartilhe este código com ninguém.
</p>
{% endblock %}
