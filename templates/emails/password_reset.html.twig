{% extends 'emails/brand_base.html.twig' %}

{% block subject %}Código pra criar uma nova senha: {{ codigo }}{% endblock %}
{% block preheader %}Use este código no app pra criar uma nova senha. Vale por 30 minutos.{% endblock %}
{% block header_label %}NOVA SENHA{% endblock %}
{% block footer_reason %}Você recebeu este e&#8209;mail porque alguém pediu uma nova senha para esta conta.{% endblock %}

{% block body %}
<p style="margin:0 0 10px;font-family:'IBM Plex Mono','SFMono-Regular',Menlo,Consolas,'Courier New',monospace;font-size:12px;line-height:16px;font-weight:600;letter-spacing:1.2px;text-transform:uppercase;color:#A3261C;"><span style="color:#BF3326;">&#9632;</span>&nbsp;RECUPERAR ACESSO</p>
<h1 class="h1" style="margin:0 0 18px;font-family:Anton,Impact,'Arial Narrow Bold','Helvetica Neue',Arial,sans-serif;font-size:34px;line-height:36px;font-weight:400;text-transform:uppercase;color:#15120F;mso-line-height-rule:exactly;">BORA CRIAR UMA SENHA NOVA.</h1>
<p style="margin:0 0 16px;font-family:Archivo,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:16px;line-height:24px;color:#15120F;">Oi, {{ nome }}!</p>
<p style="margin:0 0 20px;font-family:Archivo,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:16px;line-height:24px;color:#15120F;">Recebemos um pedido pra criar uma nova senha na sua conta. Digite este código no app:</p>
<table role="presentation" align="center" cellpadding="0" cellspacing="0" border="0" style="margin:8px auto 10px;border:0;border-collapse:separate;border-spacing:0;">
  <tr>
    <td bgcolor="#BF3326" style="padding:16px 26px 16px 38px;background-color:#BF3326;border:2px solid #15120F;border-radius:6px;text-align:center;mso-border-alt:2px solid #15120F;">
      <span style="font-family:'IBM Plex Mono','SFMono-Regular',Menlo,Consolas,'Courier New',monospace;font-size:38px;line-height:44px;font-weight:600;letter-spacing:12px;color:#FBF7EF;white-space:nowrap;">{{ codigo }}</span>
    </td>
  </tr>
</table>
<p style="margin:0 0 24px;font-family:'IBM Plex Mono','SFMono-Regular',Menlo,Consolas,'Courier New',monospace;font-size:12px;line-height:18px;font-weight:600;letter-spacing:1px;text-transform:uppercase;color:#5E554A;text-align:center;">VALE POR 30 MINUTOS <span style="color:#5E554A;">&middot;</span> USO ÚNICO</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;margin:4px 0 22px;border-collapse:separate;border-spacing:0;">
  <tr>
    <td style="padding:16px 18px;background-color:#FBF7EF;border:2px solid #BF3326;border-left-width:8px;border-radius:6px;">
      <p style="margin:0 0 6px;font-family:Archivo,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:16px;line-height:22px;font-weight:800;color:#A3261C;">Não passe este código pra ninguém.</p>
      <p style="margin:0;font-family:Archivo,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:15px;line-height:23px;color:#15120F;">A equipe da Popularia nunca pede código, senha ou token, nem por e&#8209;mail, nem por mensagem. Se alguém pedir, não é a gente.</p>
    </td>
  </tr>
</table>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;">
  <tr>
    <td style="height:20px;border-top:2px dashed #15120F;font-size:0;line-height:0;">&nbsp;</td>
  </tr>
</table>
<p style="margin:0 0 16px;font-family:Archivo,'Helvetica Neue',Helvetica,Arial,sans-serif;font-size:14px;line-height:21px;color:#5E554A;">Não pediu uma senha nova? Sua conta continua segura. É só ignorar este e&#8209;mail.</p>
{% endblock %}
